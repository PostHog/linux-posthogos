post_install() {
  /usr/share/posthogos/branding/apply-kde-defaults >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -f /usr/share/icons/posthogos >/dev/null 2>&1 || true
  gtk-update-icon-cache -q -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
  systemctl enable docker.service >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
}
