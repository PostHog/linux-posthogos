#!/usr/bin/env bash
# Launcher for the PosthogOS welcome app. Reads QtCore.Settings written by
# the QML side to decide whether to skip on autostart, then runs the QML
# window and dispatches follow-up actions based on the exit code.
#
# Exit codes from welcome.qml:
#   0   normal close
#   10  user clicked "Install to disk"  → launch Calamares
#   11  user clicked "Open terminal"     → launch Ghostty

set -e

# QtCore.Settings persists to ~/.config/<orgname>/<appname>.conf. The QML
# file doesn't set Application.organization/name explicitly, so Qt uses
# defaults — the conf path resolves to ~/.config/QtProject.conf if not
# overridden. We set them via env so the location is predictable.
export QT_APPLICATION_NAME="PosthogOS-Welcome"
export QT_ORGANIZATION_NAME="PostHog"

# Tell Qt (on Wayland) which .desktop file this app belongs to. Without
# this, qml6's window gets app ID "qml6", the compositor can't match it
# to /usr/share/applications/posthogos-welcome.desktop, and the titlebar +
# taskbar entry both show a generic blank icon. With this set, the
# compositor reads Icon= from that .desktop and uses it everywhere this
# window appears (titlebar, taskbar, alt-tab switcher, kickoff favorite).
#
# X11 fallback path uses StartupWMClass=posthogos-welcome in the .desktop
# file itself (also set there).
export QT_QPA_APP_DESKTOP_FILE_NAME=posthogos-welcome
prefs="${XDG_CONFIG_HOME:-$HOME/.config}/PostHog/PosthogOS-Welcome.conf"

# Honor the "Show on next startup" checkbox state. Default = show.
# Only the autostart entry passes --autostart; manual launches from the
# app menu always show the window regardless of the setting.
if [ "${1:-}" = "--autostart" ] && [ -f "$prefs" ]; then
    if grep -q '^showOnStartup=false' "$prefs"; then
        exit 0
    fi
fi

qml=/usr/share/posthogos/welcome.qml
[ -f "$qml" ] || { echo "Missing $qml" >&2; exit 1; }

# Prefer qml6 (Qt6) when available; fall back to plain qml.
qml_bin=$(command -v qml6 || command -v qml || true)
[ -n "$qml_bin" ] || { echo "Neither qml6 nor qml is installed (need qt6-declarative)" >&2; exit 1; }

set +e
# Capture stderr to a log so silent QML failures (missing import modules,
# syntax errors, runtime crashes) leave a trace. The autostart path has no
# attached terminal, so otherwise the user sees "cursor flashes, no window"
# with zero diagnostic surface.
#
# Plain `2>>` direct-append rather than `tee` via process substitution —
# `2> >(tee -a "$log" >&2)` is racy: the tee subshell may not flush before
# the parent exits, and stderr from qml6 silently disappeared in practice.
# Also enable QML's verbose logging so we get import/module diagnostics.
log=/tmp/posthogos-welcome.log
{
    echo "===== $(date -Iseconds) [pid=$$] $qml_bin $qml (--autostart=${1:-})"
    echo "env: HOME=$HOME XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-?} DISPLAY=${DISPLAY:-?} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-?}"
    echo "qml6 version:"
    "$qml_bin" --version 2>&1 | sed 's/^/  /'
} >>"$log" 2>&1
QT_LOGGING_RULES='qt.qml.import.debug=true' "$qml_bin" "$qml" >>"$log" 2>&1
ec=$?
echo "  exit=$ec" >>"$log"
set -e

case "$ec" in
    10) exec sudo -E calamares ;;        # Install to disk
    11) exec ghostty ;;                  # Open terminal
    *)  exit 0 ;;
esac
