#!/usr/bin/env bash
# Launcher for the PosthogOS welcome app. Reads QtCore.Settings written by
# the QML side to decide whether to skip on autostart, then runs the QML
# window and dispatches follow-up actions based on the exit code.
#
# Exit codes from welcome.qml:
#   0   normal close
#   10  user clicked "Install to disk"     → launch Calamares
#   11  user clicked "Open terminal"        → launch Ghostty
#   12  user clicked "Install dev toolkit"  → launch posthogos-toolkit-install
#         in Ghostty. Skip list read from QtCore.Settings file.

set -e

prefs="${XDG_CONFIG_HOME:-$HOME/.config}/PostHog/PosthogOS-Welcome.conf"

# Honor the "Show on next startup" checkbox state. Default = show.
# Only the autostart entry passes --autostart; manual launches from the
# app menu always show the window regardless of the setting.
if [ "${1:-}" = "--autostart" ] && [ -f "$prefs" ]; then
    if grep -q '^showOnStartup=false' "$prefs"; then
        exit 0
    fi
fi

# Stamp live-vs-installed into the Settings .conf BEFORE qml6 reads it,
# so the hero tile picks the right identity (Install to disk vs Install
# dev toolkit). /run/archiso/ exists only on the live system.
is_live="false"
[ -d /run/archiso ] && is_live="true"

mkdir -p "$(dirname "$prefs")"
if [ ! -f "$prefs" ]; then
    printf '[Startup]\nisLiveIso=%s\n' "$is_live" > "$prefs"
else
    # Strip any prior isLiveIso= line, then re-insert under [Startup].
    sed -i.bak '/^isLiveIso=/d' "$prefs" && rm -f "$prefs.bak"
    if grep -q '^\[Startup\]' "$prefs"; then
        awk -v val="$is_live" '
            /^\[Startup\]/ { print; print "isLiveIso=" val; next }
            { print }
        ' "$prefs" > "$prefs.tmp" && mv "$prefs.tmp" "$prefs"
    else
        printf '\n[Startup]\nisLiveIso=%s\n' "$is_live" >> "$prefs"
    fi
fi

# Prefer the C++ launcher, which calls QGuiApplication::setDesktopFileName()
# so Plasma matches the running window to posthogos-welcome.desktop and
# renders Professor Hog in the titlebar/taskbar. Qt docs require the call
# to be programmatic (no env var equivalent). Fall back to plain qml6 if
# the chroot compile failed (window still works, generic icon).
launcher=/usr/local/bin/posthogos-welcome-launcher
qml=/usr/share/posthogos/welcome.qml
qml_bin=$(command -v qml6 || command -v qml || true)

log=/tmp/posthogos-welcome.log
{
    echo "===== $(date -Iseconds) [pid=$$] autostart=${1:-}"
    echo "env: HOME=$HOME XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-?} DISPLAY=${DISPLAY:-?} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-?}"
} >>"$log" 2>&1

set +e
if [ -x "$launcher" ]; then
    echo "  using launcher: $launcher" >>"$log"
    "$launcher" >>"$log" 2>&1
elif [ -n "$qml_bin" ] && [ -f "$qml" ]; then
    echo "  fallback: $qml_bin $qml (launcher missing → icon will be generic)" >>"$log"
    QT_LOGGING_RULES='qt.qml.import.debug=true' "$qml_bin" "$qml" >>"$log" 2>&1
else
    echo "ERROR: no launcher binary and no qml6 fallback available" >>"$log"
    exit 1
fi
ec=$?
echo "  exit=$ec" >>"$log"
set -e

case "$ec" in
    10) exec sudo -E calamares ;;        # Install to disk
    11) exec ghostty ;;                  # Open terminal
    12)                                  # Install dev toolkit
        # On the live ISO pacman writes to tmpfs and balloons RAM, so
        # refuse politely instead of melting the user's session.
        if [ -d /run/archiso ]; then
            exec ghostty -e bash -c '
                printf "\n  \033[1;38;2;249;189;43mLive ISO detected\033[0m\n"
                printf "  The dev toolkit needs to write to disk. Install PosthogOS first,\n"
                printf "  then click \"Install dev toolkit\" again on your installed system.\n\n"
                printf "  Press Enter to close…"; read'
        fi
        # Read the skip list the QML dialog wrote, launch installer in
        # Ghostty. Script self-elevates via sudo; terminal stays open
        # post-exit so the user can read the summary.
        skip=""
        if [ -f "$prefs" ]; then
            skip=$(awk -F= "/^toolkitSkip=/{print \$2; exit}" "$prefs" | tr -d "\r")
        fi
        args=(--yes)
        [ -n "$skip" ] && args+=(--skip="$skip")
        exec ghostty -e bash -c '
            /usr/local/bin/posthogos-toolkit-install "$@"
            ec=$?
            printf "\n  Installer exited %s. Press Enter to close…" "$ec"; read' \
            -- "${args[@]}"
        ;;
    *)  exit 0 ;;
esac
