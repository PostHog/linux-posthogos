[kdeglobals][KDE]
LookAndFeelPackage=com.posthog.posthogos
widgetStyle=Breeze

[kdeglobals][Icons]
Theme=PosthogOS

[kwinrc][org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
NoPlugin=false

# wallpaperplugin MUST be set on the containment itself, not just on the
# [Wallpaper][org.kde.image][General] subsection below. Without this key
# Plasma reads "the wallpaper config for plugin 'org.kde.image' is X" but
# never learns which plugin to actually instantiate, falls back to empty
# pluginid, and triggers the desktop-wide "Error loading Applet: package
# does not exist." overlay (tell-tale double space where the pluginid
# would go). Previously fixed for plasmalogin's greeter via
# /etc/plasmalogin.conf's WallpaperPluginId; this is the same fix for
# the user-session desktop containment.
[plasma-org.kde.plasma.desktop-appletsrc][Containments][1]
wallpaperplugin=org.kde.image

[plasma-org.kde.plasma.desktop-appletsrc][Containments][1][Wallpaper][org.kde.image][General]
Image=/usr/share/wallpapers/PosthogosKeyboardGarden/
