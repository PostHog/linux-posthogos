// PosthogOS boot splash
//
// Solid #151515 background, PostHog logomark centred, gently pulsing
// to indicate liveness. Three loading dots below the logo. Updates
// progress via the standard Plymouth refresh callback.
//
// Plymouth scripting reference:
//   https://www.freedesktop.org/wiki/Software/Plymouth/Scripts/

# ---- Background ----------------------------------------------------------
Window.SetBackgroundTopColor(0.082, 0.082, 0.082);     // #151515
Window.SetBackgroundBottomColor(0.082, 0.082, 0.082);  // #151515

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---- Logo (centred) ------------------------------------------------------
logo.image = Image("logo.png");
logo.w = logo.image.GetWidth();
logo.h = logo.image.GetHeight();
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_w / 2 - logo.w / 2);
logo.sprite.SetY(screen_h / 2 - logo.h / 2);

# ---- Loading dots --------------------------------------------------------
dot.image = Image("dot.png");
dot.w = dot.image.GetWidth();
dot.h = dot.image.GetHeight();
dot.spacing = 16;
dot.row_y = screen_h / 2 + logo.h / 2 + 40;
dot.row_x = screen_w / 2 - (dot.w * 3 + dot.spacing * 2) / 2;

for (i = 0; i < 3; i++) {
    dots[i].sprite = Sprite(dot.image);
    dots[i].sprite.SetX(dot.row_x + i * (dot.w + dot.spacing));
    dots[i].sprite.SetY(dot.row_y);
    dots[i].sprite.SetOpacity(0.25);
}

# ---- Password prompt sprites ---------------------------------------------
# "normal" = booting (logo pulse + loading dots); "password" = waiting for a
# LUKS passphrase (prompt text + one bullet per typed char, dots hidden).
status = "normal";

# Prompt text sprite (image set on demand in the password callback).
prompt.sprite = Sprite();
prompt.sprite.SetOpacity(0);

# Typed-character bullets reuse the loading-dot glyph. Sprites are created
# lazily and reused across keystrokes; bullet_count tracks the high-water
# mark so we can hide the tail after a backspace.
bullet.spacing = 10;
bullet_count = 0;

# ---- Animation -----------------------------------------------------------
progress = 0;

fun refresh_callback() {
    progress += 0.04;

    // Pulse the logo opacity 0.65 → 1.0 (liveness, in both modes)
    pulse = (Math.Sin(progress) + 1) / 2;       // 0..1
    logo.sprite.SetOpacity(0.65 + pulse * 0.35);

    // While waiting for a passphrase, don't animate the loading dots — a
    // moving "loading" indicator hides the fact that input is required.
    if (status == "password")
        return;

    // Walk the dots: each dot lights up in turn
    active = Math.Int(progress * 1.5) % 3;
    for (i = 0; i < 3; i++) {
        if (i == active)
            dots[i].sprite.SetOpacity(1.0);
        else
            dots[i].sprite.SetOpacity(0.25);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# Hide everything once boot finishes
fun quit_callback() {
    logo.sprite.SetOpacity(0);
    for (i = 0; i < 3; i++) dots[i].sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    hide_bullets();
}
Plymouth.SetQuitFunction(quit_callback);

# Password prompts (used at boot if the disk is encrypted).
# `prompt_text` is the cryptsetup prompt (e.g. "Please enter passphrase…");
# `bullets` is the number of characters typed so far. Without rendering both,
# a LUKS user sees only the pulsing logo and no sign input is needed.
fun hide_bullets() {
    for (i = 0; i < bullet_count; i++)
        if (bullets_sprites[i]) bullets_sprites[i].SetOpacity(0);
}

fun display_password_callback(prompt_text, bullets) {
    status = "password";

    // Hide the loading dots for the duration of the prompt.
    for (i = 0; i < 3; i++) dots[i].sprite.SetOpacity(0);

    // Prompt line, centred just below the logo (cream #EEEFE9).
    prompt.image = Image.Text(prompt_text, 0.93, 0.94, 0.91, 1, "Sans 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(screen_w / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(dot.row_y);
    prompt.sprite.SetOpacity(1);

    // One bullet per typed character, centred in a row under the prompt.
    bw = dot.w + bullet.spacing;
    row_w = bullets * dot.w + (bullets - 1) * bullet.spacing;
    if (row_w < 0) row_w = 0;
    start_x = screen_w / 2 - row_w / 2;
    bullets_y = dot.row_y + prompt.image.GetHeight() + 16;
    for (i = 0; i < bullets; i++) {
        if (!bullets_sprites[i]) bullets_sprites[i] = Sprite(dot.image);
        bullets_sprites[i].SetX(start_x + i * bw);
        bullets_sprites[i].SetY(bullets_y);
        bullets_sprites[i].SetOpacity(1.0);
    }
    if (bullets > bullet_count) bullet_count = bullets;
    // Hide any bullets left over from a longer previous entry (backspace).
    for (i = bullets; i < bullet_count; i++)
        if (bullets_sprites[i]) bullets_sprites[i].SetOpacity(0);
}

fun display_normal_callback() {
    status = "normal";
    prompt.sprite.SetOpacity(0);
    hide_bullets();
}
fun message_callback(text) {}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetMessageFunction(message_callback);
