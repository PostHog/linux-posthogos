[Desktop Entry]
Type=Application
Name=PosthogOS first-run setup
Comment=Apply the PosthogOS theme on first login (KDE Plasma or GNOME)
Exec=/usr/local/bin/posthogos-firstrun.sh
NoDisplay=true
Terminal=false
# No OnlyShowIn: the script dispatches on the detected desktop (Plasma /
# GNOME / unsupported) itself, so it must run everywhere. Also dodges the
# Plasma-6-desktop-name-isn't-"KDE" trap.
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=plasma-session-running
