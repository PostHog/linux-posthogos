# PosthogOS default .gitconfig — seeded into new user homes via /etc/skel.
#
# Only opinion is the delta pager + a few defaults that make modern git
# nicer. Personal identity (user.name, user.email) is intentionally NOT
# preset — git will prompt on first commit.
#
# This is per-user config. To override system-wide, use /etc/gitconfig.

[core]
    pager = delta
    editor = "${EDITOR:-nano}"

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true              # n/N jumps between diff sections in delta's view
    light = false                # use dark-mode delta colors regardless of terminal bg
    line-numbers = true
    side-by-side = false         # toggle to true if you prefer split view
    syntax-theme = "ansi"
    file-style = "#EB9D2A bold"
    file-decoration-style = "#EB9D2A overline"
    hunk-header-style = "syntax bold"
    hunk-header-decoration-style = "#1D4AFF box"
    minus-style = "syntax #4a1e1e"
    minus-emph-style = "syntax #7a2828"
    plus-style = "syntax #1e3a1e"
    plus-emph-style = "syntax #285028"

[merge]
    conflictStyle = zdiff3       # newer, smarter conflict markers (git 2.35+)

[pull]
    rebase = true                # rebase by default — fewer merge commits

[push]
    autoSetupRemote = true       # `git push` works on new branches without -u

[init]
    defaultBranch = main

[fetch]
    prune = true                 # auto-drop refs for deleted remote branches

[diff]
    algorithm = histogram
    colorMoved = default

[rebase]
    autoSquash = true
    autoStash = true
