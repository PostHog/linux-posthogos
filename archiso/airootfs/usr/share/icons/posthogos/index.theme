[Icon Theme]
Name=PostHogOS
Comment=PostHogOS folder and place icons, inheriting Breeze for the rest
Inherits=breeze,hicolor
Directories=128x128/places,128x128/mimetypes,scalable/places,scalable/mimetypes

[128x128/places]
Size=128
Context=Places
Type=Fixed

[128x128/mimetypes]
Size=128
Context=MimeTypes
Type=Fixed

[scalable/places]
Size=64
Context=Places
Type=Scalable
MinSize=16
MaxSize=256

[scalable/mimetypes]
Size=64
Context=MimeTypes
Type=Scalable
MinSize=16
MaxSize=256
