# macOS
.DS_Store

# Editor
.idea
.vscode
*.swp
*.swo
*~

# Build artifacts
build/
out/
overlay-generated/
.pacman-cache/
.airootfs-cache/
*.iso
test-disk.qcow2

# Logs
*.log

# Local build config. Committed template lives at .env.example; copy
# (`cp .env.example .env`) and fill in machine-specific paths +
# preferences. Auto-sourced by bin/build and bin/test.
.env

# Secrets
*.sec
*.pub

# makepkg local build artifacts. PKGBUILD's build() / package() write
# into ./src/ and ./pkg/ inside each PKGBUILD dir; the final
# .pkg.tar.zst (+ .sig) also lands there unless PKGDEST overrides.
# Regenerated on every `bin/build` and `makepkg` invocation.
packages/*/pkg/
packages/*/src/
packages/*/*.pkg.tar.zst
packages/*/*.pkg.tar.zst.sig
