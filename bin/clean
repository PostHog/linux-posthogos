#!/usr/bin/env bash
#/ Usage: bin/clean [--deep] [--cache]
#/ Description: Remove build artifacts.
#/   default: rm -rf build/ out/
#/   --cache: also remove .pacman-cache/ and .airootfs-cache/.
#/            Next build will re-download (~2.4 GB) and re-pacstrap (~10 min).
#/   --deep:  --cache + remove the posthogos-builder Docker image.

source bin/helpers/_utils.sh
set_source_and_root_dir
set -e

deep=false
clean_cache=false
case "${1:-}" in
    --deep)        deep=true; clean_cache=true ;;
    --cache)       clean_cache=true ;;
    -h|--help)     show_help; exit 0 ;;
    "")            ;;
    *)             fatal "Unknown arg: $1" ;;
esac

print_color blue "Removing build/ and out/..."
# mkarchiso leaves some dirs mode 0555 (e.g. ca-certificates/extracted/cadir),
# which blocks rm -rf even as root. chmod first.
for d in build out; do
    [ -e "$d" ] || continue
    if [ -w "$d" ] || [ "$(id -u)" -eq 0 ]; then
        chmod -R u+w "$d" 2>/dev/null || sudo chmod -R u+w "$d"
        rm -rf "$d" 2>/dev/null || sudo rm -rf "$d"
    else
        sudo chmod -R u+w "$d"
        sudo rm -rf "$d"
    fi
done

if [ "$clean_cache" = true ]; then
    for d in .pacman-cache .airootfs-cache; do
        [ -d "$d" ] || continue
        print_color blue "Removing $d..."
        if [ -w "$d" ]; then
            rm -rf "$d"
        else
            sudo rm -rf "$d"
        fi
    done
fi

if [ "$deep" = true ]; then
    if command_exists docker; then
        print_color blue "Removing posthogos-builder Docker image..."
        docker image rm posthogos-builder 2>/dev/null || true
    fi
fi

success "Clean complete"
