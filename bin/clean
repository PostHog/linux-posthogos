#!/usr/bin/env bash
#/ Usage: bin/clean [--deep]
#/ Description: Remove build artifacts.
#/   default: rm -rf build/ out/
#/   --deep:  also remove the posthogos-builder Docker image

source bin/helpers/_utils.sh
set_source_and_root_dir
set -e

deep=false
[ "${1:-}" = "--deep" ] && deep=true
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { show_help; exit 0; }

print_color blue "Removing build/ and out/..."
rm -rf build out

if [ "$deep" = true ]; then
    if command_exists docker; then
        print_color blue "Removing posthogos-builder Docker image..."
        docker image rm posthogos-builder 2>/dev/null || true
    fi
fi

success "Clean complete"
