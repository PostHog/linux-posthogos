#!/usr/bin/env bash
#/ Usage: bin/build [--native] [--keep-build]
#/ Description: Build the PosthogOS ISO.
#/ Options:
#/   --native        Run buildiso.sh directly on the host (requires Arch + archiso).
#/                   Default is Docker (required on macOS).
#/   --keep-build    Don't delete the build/ work tree afterwards (faster iteration).

source bin/helpers/_utils.sh
set_source_and_root_dir
load_env_file
set -e

native=false
keep_build=false
while (( $# )); do
    case "$1" in
        --native)     native=true; shift;;
        --keep-build) keep_build=true; shift;;
        -h|--help)    show_help; exit 0;;
        *) fatal "Unknown arg: $1";;
    esac
done

if [ ! -d upstream/archiso ]; then
    print_color yellow "Initializing upstream/ submodule..."
    git submodule update --init upstream || fatal "Failed to init upstream submodule"
fi

mkdir -p out

# --- Target architecture (single source of truth) -------------------------
# x86_64 is the only fully-working target today: the package base (Arch +
# CachyOS, including the linux-cachyos kernel) ships x86_64 only, so an
# aarch64 build fails at pacstrap until it's ported to an arm package base.
BUILD_ARCH="${BUILD_ARCH:-x86_64}"
case "$BUILD_ARCH" in
    x86_64)  docker_platform="linux/amd64"; appimage_arch_re='x64|x86_64|amd64' ;;
    aarch64) docker_platform="linux/arm64"; appimage_arch_re='arm64|aarch64' ;;
    *) fatal "Unsupported BUILD_ARCH '$BUILD_ARCH' (expected x86_64 or aarch64)" ;;
esac
export BUILD_ARCH

# Stage the PostHog Code AppImage from the latest GitHub release.
# build-assets.sh consumes .appimages/posthog-code.AppImage; skip silently
# if the latest release has no .AppImage asset (the launcher just won't
# show up in the menu / Kickoff favorites). Cached by release tag —
# re-downloads only when upstream cuts a new release.
mkdir -p .appimages
appimage_dst=".appimages/posthog-code.AppImage"
appimage_tag_marker=".appimages/.posthog-code-tag"

# Match the AppImage to the ISO's *target* arch (BUILD_ARCH), not the build
# host: on an Apple Silicon Mac the host is arm64 but the default build is an
# x86_64 ISO inside a linux/amd64 container, and the AppImage runs on the
# installed system.
posthog_code_api="https://api.github.com/repos/PostHog/code/releases/latest"
release_json=$(curl -sfL -H 'Accept: application/vnd.github+json' "$posthog_code_api" 2>/dev/null || true)
if [ -z "$release_json" ]; then
    print_color yellow "Could not query PostHog/code releases (network? rate limit?); skipping AppImage stage"
else
    # No deps on jq/gh — grep the JSON for the .AppImage matching the ISO arch.
    # A release ships both x64 and arm64 AppImages; the arch token sits right
    # before the .AppImage suffix (e.g. ...-x64.AppImage), so anchor on that.
    asset_url=$(printf '%s' "$release_json" \
        | grep -Eo '"browser_download_url":[[:space:]]*"[^"]+\.AppImage"' \
        | sed -E 's/.*"(https[^"]+\.AppImage)".*/\1/' \
        | grep -iE "($appimage_arch_re)\.AppImage\$" \
        | head -n1)
    upstream_tag=$(printf '%s' "$release_json" \
        | grep -Eo '"tag_name":[[:space:]]*"[^"]+"' \
        | head -n1 \
        | sed -E 's/.*"tag_name":[[:space:]]*"([^"]+)".*/\1/')
    # Cache key includes arch so switching ISO arch invalidates a stale AppImage.
    appimage_cache_key="${upstream_tag} ${BUILD_ARCH}"
    if [ -z "$asset_url" ]; then
        print_color yellow "PostHog/code release (${upstream_tag:-unknown}) has no .AppImage for $BUILD_ARCH; skipping"
        rm -f "$appimage_dst" "$appimage_tag_marker"
    elif [ -f "$appimage_dst" ] && [ "$(cat "$appimage_tag_marker" 2>/dev/null)" = "$appimage_cache_key" ]; then
        print_color blue "PostHog Code AppImage cached ($upstream_tag, $BUILD_ARCH); skipping download"
    else
        print_color blue "Downloading PostHog Code AppImage ($upstream_tag, $BUILD_ARCH) → $appimage_dst"
        curl -fL --progress-bar -o "$appimage_dst.partial" "$asset_url" \
            || fatal "AppImage download failed: $asset_url"
        mv "$appimage_dst.partial" "$appimage_dst"
        chmod +x "$appimage_dst"
        printf '%s\n' "$appimage_cache_key" > "$appimage_tag_marker"
    fi
fi

export KEEP_BUILD="$keep_build"

# Expand POSTHOGOS_PACKAGER_KEY_FILE → POSTHOGOS_PACKAGER_KEY so .env can
# reference the secret key on disk instead of trying to inline a multi-line
# armored block (load_env_file is single-line KEY=value only). Mirrors
# Docker secrets / Kubernetes envFrom file-mount conventions. The KEY var
# itself is what in-container-build.sh imports into gpg.
if [ -z "${POSTHOGOS_PACKAGER_KEY:-}" ] && [ -n "${POSTHOGOS_PACKAGER_KEY_FILE:-}" ]; then
    [ -f "$POSTHOGOS_PACKAGER_KEY_FILE" ] \
        || fatal "POSTHOGOS_PACKAGER_KEY_FILE set but file missing: $POSTHOGOS_PACKAGER_KEY_FILE"
    export POSTHOGOS_PACKAGER_KEY="$(cat "$POSTHOGOS_PACKAGER_KEY_FILE")"
fi

if [ "$native" = true ]; then
    print_color blue "Building natively (host must be Arch with archiso installed)..."
    exec sudo -E scripts/in-container-build.sh
fi

print_color blue "Building PosthogOS builder image ($BUILD_ARCH / $docker_platform)..."
docker build --platform="$docker_platform" --build-arg BUILD_ARCH="$BUILD_ARCH" \
    -t "posthogos-builder-$BUILD_ARCH" -f Dockerfile .

print_color blue "Running build in privileged container..."
# Persistent pacman cache: ~2.4 GB on first build, near-zero deltas after.
# Wipe with: rm -rf .pacman-cache  (or bin/clean --cache)
mkdir -p .pacman-cache
docker run --rm --privileged \
    --name posthogos \
    --platform="$docker_platform" \
    -v "$PWD":/work \
    -v "$PWD/.pacman-cache":/var/cache/pacman/pkg \
    -e KEEP_BUILD \
    -e FAST_BUILD \
    -e SQUASHFS_COMP \
    -e SQUASHFS_ZSTD_LEVEL \
    -e SDDM_BG \
    -e SDDM_BG_BLUR \
    -e CI \
    -e GITHUB_ACTIONS \
    -e POSTHOGOS_PACKAGER_KEY \
    -e POSTHOGOS_PACKAGER_KEY_FPR \
    -e POSTHOGOS_PKGVER \
    -e BUILD_ARCH \
    -w /work \
    "posthogos-builder-$BUILD_ARCH" \
    /work/scripts/in-container-build.sh

iso=$(ls -1t out/*.iso 2>/dev/null | head -n1 || true)
if [ -n "$iso" ]; then
    # Strip macOS xattrs (Docker tags container-written files with
    # com.apple.quarantine, which UTM's sandboxed QEMU refuses to open).
    # No-op on Linux and on already-clean files.
    command -v xattr >/dev/null 2>&1 && xattr -c "$iso" 2>/dev/null || true
    success "Built: $iso ($(du -h "$iso" | cut -f1))"
else
    fatal "Build finished but no ISO landed in out/"
fi
