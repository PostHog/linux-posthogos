#!/usr/bin/env bash
#/ Usage: bin/build [--native] [--keep-build]
#/ Description: Build the PosthogOS ISO.
#/ Options:
#/   --native        Run buildiso.sh directly on the host (requires Arch + archiso).
#/                   Default is Docker (required on macOS).
#/   --keep-build    Don't delete the build/ work tree afterwards (faster iteration).

source bin/helpers/_utils.sh
set_source_and_root_dir
load_env_file
set -e

native=false
keep_build=false
while (( $# )); do
    case "$1" in
        --native)     native=true; shift;;
        --keep-build) keep_build=true; shift;;
        -h|--help)    show_help; exit 0;;
        *) fatal "Unknown arg: $1";;
    esac
done

if [ ! -d upstream/archiso ]; then
    print_color yellow "Initializing upstream/ submodule..."
    git submodule update --init upstream || fatal "Failed to init upstream submodule"
fi

mkdir -p out

# Optional: bundle the PostHog Code AppImage as a default app.
# The build container only sees files under /work (= repo root), so we
# stage the AppImage into .appimages/ (gitignored, 200+ MB so never
# commit). build-assets.sh checks that path and skips silently if absent;
# CI without an AppImage still builds a valid ISO, the launcher just
# won't show up in the menu / Kickoff favorites.
if [ -n "${POSTHOG_CODE_APPIMAGE:-}" ]; then
    [ -f "$POSTHOG_CODE_APPIMAGE" ] || fatal "POSTHOG_CODE_APPIMAGE set but file missing: $POSTHOG_CODE_APPIMAGE"
    mkdir -p .appimages
    # Use mv-like semantics via cp+stat-check: skip the copy if source and
    # dest are identical (saves time on a 200 MB file across iterations).
    src_size=$(stat -f%z "$POSTHOG_CODE_APPIMAGE" 2>/dev/null || stat -c%s "$POSTHOG_CODE_APPIMAGE")
    dst=.appimages/posthog-code.AppImage
    if [ ! -f "$dst" ] || [ "$(stat -f%z "$dst" 2>/dev/null || stat -c%s "$dst")" != "$src_size" ]; then
        print_color blue "Staging PostHog Code AppImage (${src_size} bytes) → $dst"
        cp -f "$POSTHOG_CODE_APPIMAGE" "$dst"
    else
        print_color blue "PostHog Code AppImage already staged at $dst (same size; skipping copy)"
    fi
fi

export KEEP_BUILD="$keep_build"

if [ "$native" = true ]; then
    print_color blue "Building natively (host must be Arch with archiso installed)..."
    exec sudo -E scripts/in-container-build.sh
fi

print_color blue "Building PosthogOS builder image..."
docker build --platform=linux/amd64 -t posthogos-builder -f Dockerfile .

print_color blue "Running build in privileged container..."
# Persistent pacman cache: ~2.4 GB on first build, near-zero deltas after.
# Wipe with: rm -rf .pacman-cache  (or bin/clean --cache)
mkdir -p .pacman-cache
docker run --rm --privileged \
    --name posthogos \
    --platform=linux/amd64 \
    -v "$PWD":/work \
    -v "$PWD/.pacman-cache":/var/cache/pacman/pkg \
    -e KEEP_BUILD \
    -e FAST_BUILD \
    -e SDDM_BG \
    -e SDDM_BG_BLUR \
    -e CI \
    -e GITHUB_ACTIONS \
    -e POSTHOGOS_PACKAGER_KEY \
    -e POSTHOGOS_PACKAGER_KEY_FPR \
    -w /work \
    posthogos-builder \
    /work/scripts/in-container-build.sh

iso=$(ls -1t out/*.iso 2>/dev/null | head -n1 || true)
if [ -n "$iso" ]; then
    # Strip macOS xattrs (Docker tags container-written files with
    # com.apple.quarantine, which UTM's sandboxed QEMU refuses to open).
    # No-op on Linux and on already-clean files.
    command -v xattr >/dev/null 2>&1 && xattr -c "$iso" 2>/dev/null || true
    success "Built: $iso ($(du -h "$iso" | cut -f1))"
else
    fatal "Build finished but no ISO landed in out/"
fi
