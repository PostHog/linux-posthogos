#!/usr/bin/env bash
#/ Usage: bin/build [--native] [--keep-build]
#/ Description: Build the PosthogOS ISO.
#/ Options:
#/   --native        Run buildiso.sh directly on the host (requires Arch + archiso).
#/                   Default is Docker (required on macOS).
#/   --keep-build    Don't delete the build/ work tree afterwards (faster iteration).

source bin/helpers/_utils.sh
set_source_and_root_dir
set -e

native=false
keep_build=false
while (( $# )); do
    case "$1" in
        --native)     native=true; shift;;
        --keep-build) keep_build=true; shift;;
        -h|--help)    show_help; exit 0;;
        *) fatal "Unknown arg: $1";;
    esac
done

if [ ! -d upstream/archiso ]; then
    print_color yellow "Initializing upstream/ submodule..."
    git submodule update --init upstream || fatal "Failed to init upstream submodule"
fi

mkdir -p out

export KEEP_BUILD="$keep_build"

if [ "$native" = true ]; then
    print_color blue "Building natively (host must be Arch with archiso installed)..."
    exec sudo -E scripts/in-container-build.sh
fi

print_color blue "Building PosthogOS builder image..."
docker build -t posthogos-builder -f Dockerfile .

print_color blue "Running build in privileged container..."
docker run --rm --privileged \
    -v "$PWD":/work \
    -e KEEP_BUILD \
    -w /work \
    posthogos-builder \
    /work/scripts/in-container-build.sh

iso=$(ls -1t out/*.iso 2>/dev/null | head -n1 || true)
if [ -n "$iso" ]; then
    success "Built: $iso ($(du -h "$iso" | cut -f1))"
else
    fatal "Build finished but no ISO landed in out/"
fi
