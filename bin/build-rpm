#!/usr/bin/env bash
#/ Usage: bin/build-rpm
#/ Description: Build .rpm packages + a signed dnf repo for Fedora/RHEL/openSUSE.
#/ Notes:
#/   Consumes the pacman packages produced by bin/build (out/pkgs/*.pkg.tar.zst),
#/   so run `bin/build` first. The rpm toolchain isn't on macOS, so this runs
#/   scripts/build-rpm-packages.sh inside a fedora:latest container (whose rpm
#/   signing is the most reliable). Output lands in out/rpm/.
#/
#/   Signing: set POSTHOGOS_PACKAGER_KEY (+ _FPR), or POSTHOGOS_PACKAGER_KEY_FILE,
#/   in your environment / .env to sign the rpms + repomd. Unset → unsigned repo.

source bin/helpers/_utils.sh
set_source_and_root_dir
load_env_file
set -e

[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { show_help; exit 0; }

ls out/pkgs/posthogos-branding-*.pkg.tar.zst >/dev/null 2>&1 \
    || fatal "out/pkgs/ has no posthogos packages — run bin/build first."

# Same .env → KEY indirection as bin/build (load_env_file is single-line only).
if [ -z "${POSTHOGOS_PACKAGER_KEY:-}" ] && [ -n "${POSTHOGOS_PACKAGER_KEY_FILE:-}" ]; then
    [ -f "$POSTHOGOS_PACKAGER_KEY_FILE" ] \
        || fatal "POSTHOGOS_PACKAGER_KEY_FILE set but file missing: $POSTHOGOS_PACKAGER_KEY_FILE"
    export POSTHOGOS_PACKAGER_KEY="$(cat "$POSTHOGOS_PACKAGER_KEY_FILE")"
fi

if command_exists rpmbuild && command_exists createrepo_c; then
    print_color blue "Building RPM packages + dnf repo natively..."
    exec scripts/build-rpm-packages.sh
fi

print_color blue "Building RPM packages + dnf repo in fedora:latest..."
docker run --rm \
    -v "$PWD":/work -w /work \
    -e POSTHOGOS_PKGVER \
    -e POSTHOGOS_PACKAGER_KEY \
    -e POSTHOGOS_PACKAGER_KEY_FPR \
    -e PKG_SRC_DIR \
    -e RPM_OUT_DIR \
    fedora:latest \
    bash -c 'set -e
        dnf install -y --setopt=install_weak_deps=False \
            rpm-build rpm-sign createrepo_c gnupg2 zstd tar findutils git >/dev/null
        git config --global --add safe.directory /work || true
        scripts/build-rpm-packages.sh'

success "dnf repo built at out/rpm/"
