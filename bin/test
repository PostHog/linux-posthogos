#!/usr/bin/env bash
#/ Usage: bin/test [--install] [--iso PATH] [--utm]
#/ Description: Boot the latest PosthogOS ISO in an emulator.
#/
#/ By default uses bare QEMU, boots live-only.
#/ --install   attaches a 30G qcow2 disk so you can run Calamares end-to-end
#/             (qemu mode only; UTM disk attachment is GUI-driven)
#/ --iso PATH  overrides the auto-detected ISO
#/ --utm       run in UTM (macOS only). UTM has proper clipboard sharing,
#/             audio, shared folders, etc. If a UTM VM named "PosthogOS"
#/             already exists it just starts it; otherwise opens UTM with
#/             the ISO for first-time setup. Override VM name with env
#/             POSTHOGOS_UTM_VM=<name>.
#/
#/ Notes:
#/   - QEMU mode: uses HVF/KVM where available, multi-threaded TCG with
#/     enlarged translation cache otherwise (Apple Silicon → x86_64 guest).
#/   - Requires OVMF firmware (UEFI boot) for QEMU mode. Path is auto-discovered.
#/
#/ Tunables (env vars, all optional):
#/   POSTHOGOS_QEMU_RAM=8G       guest RAM (default 8G)
#/   POSTHOGOS_QEMU_SMP=8        guest vCPUs (default: min(host-cores, 8))
#/   POSTHOGOS_QEMU_CPU=Penryn   guest CPU model when emulating (default Penryn,
#/                               since simpler instructions translate faster under TCG;
#/                               try `qemu64`, `max`, or `Westmere` if you need
#/                               specific features)

source bin/helpers/_utils.sh
set_source_and_root_dir
set -e

install_mode=false
iso=""
emulator="qemu"
while (( $# )); do
    case "$1" in
        --install)   install_mode=true; shift;;
        --iso)       iso="$2"; shift 2;;
        --utm)       emulator="utm"; shift;;
        -h|--help)   show_help; exit 0;;
        *) fatal "Unknown arg: $1";;
    esac
done

if [ -z "$iso" ]; then
    iso=$(ls -1t out/*.iso 2>/dev/null | head -n1 || true)
fi
[ -n "$iso" ] && [ -f "$iso" ] || fatal "No ISO found. Run bin/build first or pass --iso PATH."

# Absolute path: UTM needs it to resolve from its own working directory.
iso=$(cd "$(dirname "$iso")" && printf '%s/%s' "$PWD" "$(basename "$iso")")

# ---- UTM path ------------------------------------------------------------
if [ "$emulator" = "utm" ]; then
    [ "$(uname -s)" = "Darwin" ] || fatal "--utm is macOS-only"
    [ -d /Applications/UTM.app ] || fatal "UTM not installed. brew install --cask utm"
    if [ "$install_mode" = true ]; then
        warning "--install is ignored in UTM mode (attach disks via UTM's GUI)"
    fi

    utmctl="/Applications/UTM.app/Contents/MacOS/utmctl"
    vm_name="${POSTHOGOS_UTM_VM:-PosthogOS}"

    # If a VM with that name already exists in UTM, just start it. This is
    # the common case after first-time setup; no need to drop back into
    # the new-VM wizard every time.
    if [ -x "$utmctl" ]; then
        # `utmctl list` prints "UUID  Status  Name…" with Name possibly
        # containing spaces. Strip the first two fields to get the name.
        if "$utmctl" list 2>/dev/null \
            | awk 'NR>1 { $1=""; $2=""; sub(/^[ \t]+/, ""); print }' \
            | grep -qFx "$vm_name"; then
            print_color blue "Starting UTM VM \"$vm_name\"..."
            "$utmctl" start "$vm_name" 2>&1
            exit 0
        fi
    fi

    # No matching VM. Drop into the new-VM setup flow.
    print_color blue "No UTM VM named \"$vm_name\"; opening UTM with $iso for first-time setup..."
    print_color yellow "  (override the expected VM name with: POSTHOGOS_UTM_VM=<name> bin/test --utm)"
    open -a UTM "$iso"
    cat <<EOF

UTM is launching. First-time setup:
  1. Click "Create a New Virtual Machine" → "Emulate" (since the ISO is
     x86_64 and you're likely on Apple Silicon)
  2. Operating System: Linux
  3. Browse for the boot ISO and pick:
       $iso
  4. CPU/RAM: 2 cores, 4 GB (good defaults)
  5. Storage: 30 GB (only needed if you want to run Calamares)
  6. Shared directory: optional
  7. Name it "$vm_name" (so subsequent \`bin/test --utm\` just starts it).
EOF
    exit 0
fi

# ---- QEMU path -----------------------------------------------------------
require_commands qemu-system-x86_64

# Locate OVMF firmware (UEFI). Search common locations.
ovmf=""
for candidate in \
    /opt/homebrew/share/qemu/edk2-x86_64-code.fd \
    /usr/local/share/qemu/edk2-x86_64-code.fd \
    /usr/share/edk2-ovmf/x64/OVMF_CODE.fd \
    /usr/share/edk2/x64/OVMF_CODE.fd \
    /usr/share/OVMF/OVMF_CODE.fd; do
    [ -f "$candidate" ] && ovmf="$candidate" && break
done
[ -n "$ovmf" ] || fatal "OVMF firmware not found. Install qemu's edk2 firmware package."

# ---- Accel + CPU + perf flags --------------------------------------------
# Detect what acceleration is actually available and tune accordingly.
#
# On Apple Silicon emulating x86_64, HVF is rejected (cross-arch) → falls
# back to TCG software translation. TCG's defaults are conservative; the
# tunings below squeeze ~3-5× more performance:
#   thread=multi   parallelizes guest CPU emulation across host cores
#                  (default is single-threaded, emulating all guest CPUs
#                  on one host thread)
#   tb-size=512    bigger translation-block cache (default ~32 MiB) so
#                  hot guest code doesn't get re-translated
#
# On Intel Macs and Linux+KVM, HVF/KVM handle x86 natively → no TCG
# tunings needed, just -cpu host for full instruction set.

is_emulating_x86=0   # 1 when we're cross-arch (Apple Silicon → x86 guest)
case "$(uname -s)" in
    Darwin)
        if [ "$(uname -m)" = "arm64" ]; then
            accel="tcg,thread=multi,tb-size=512"
            cpu_flag=(-cpu "${POSTHOGOS_QEMU_CPU:-Penryn}")
            is_emulating_x86=1
        else
            accel="hvf:tcg"
            cpu_flag=(-cpu host)
        fi
        ;;
    Linux)
        if [ -e /dev/kvm ]; then
            accel="kvm"
            cpu_flag=(-cpu host)
        else
            accel="tcg,thread=multi,tb-size=512"
            cpu_flag=(-cpu "${POSTHOGOS_QEMU_CPU:-Penryn}")
        fi
        ;;
    *)
        accel="tcg,thread=multi,tb-size=512"
        cpu_flag=(-cpu "${POSTHOGOS_QEMU_CPU:-Penryn}")
        ;;
esac

# Host cores → guest vCPUs (capped at 8; TCG threading scales sub-linearly
# past that). RAM bumped to 8G because KDE Plasma 6 wants room to breathe, and
# more RAM means less swapping to the (slow, emulated) virtio disk.
host_cores=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
smp_count="${POSTHOGOS_QEMU_SMP:-$(( host_cores > 8 ? 8 : host_cores ))}"
ram="${POSTHOGOS_QEMU_RAM:-8G}"

args=(
    -machine "type=q35,accel=$accel"
    "${cpu_flag[@]}"
    -m "$ram" -smp "$smp_count"
    -drive "if=pflash,format=raw,readonly=on,file=$ovmf"
    -drive "file=$iso,media=cdrom,readonly=on"
    -boot order=d
    # User-mode networking + port forward: host:2222 → guest:22, host:8000
    # → guest:8000. SSH into the live ISO for proper copy/paste with:
    #   sudo systemctl start sshd && sudo passwd liveuser
    #   # then from host:
    #   ssh -o StrictHostKeyChecking=no -p 2222 liveuser@localhost
    -netdev user,id=net0,hostfwd=tcp::2222-:22,hostfwd=tcp::8000-:8000
    -device virtio-net-pci,netdev=net0
    -vga virtio
    -display default
    # Audio: route guest audio out as a no-op (suppresses the "no audio
    # backend" warning without burning emulation cycles on actual audio).
    -audio none
)

if [ "$install_mode" = true ]; then
    disk="out/test-disk.qcow2"
    if [ ! -f "$disk" ]; then
        print_color blue "Creating $disk (30G)..."
        qemu-img create -f qcow2 "$disk" 30G >/dev/null
    fi
    args+=(-drive "file=$disk,if=virtio,format=qcow2")
fi

if [ "$is_emulating_x86" = "1" ]; then
    print_color yellow "  emulating x86_64 on $(uname -m): expect ~2-5 min boot via TCG"
    print_color yellow "  for native speed: bin/test --utm  OR  test on a real x86_64 box"
fi
print_color blue "Booting $iso (qemu, accel=$accel, $smp_count vCPUs, $ram RAM)..."
exec qemu-system-x86_64 "${args[@]}"
