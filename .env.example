# Copy to `.env` (which is .gitignored) and edit for your machine.
# Auto-sourced by bin/build and bin/test before any of their own logic
# runs, so anything you set here behaves like an env var on the command
# line.

# --- AppImage bundling -----------------------------------------------------
# Path to a PostHog Code AppImage
#POSTHOG_CODE_APPIMAGE=/Users/you/Downloads/posthog-code.AppImage

# --- Build modes -----------------------------------------------------------
# Saves ~10-15 min per build 
#FAST_BUILD=1

#Don't `rm -rf build/` after a successful build
#KEEP_BUILD=1

# --- Icon theme variant ----------------------------------------------------
# Which set of PostHog product icons to ship (classic | modern)
#POSTHOGOS_ICON_VARIANT=modern

# --- QEMU test tunables -----------------------------------
# Guest RAM / vCPUs / CPU model for `bin/test`
#POSTHOGOS_QEMU_RAM=8G
#POSTHOGOS_QEMU_SMP=8
#POSTHOGOS_QEMU_CPU=Penryn

# --- UTM emulator --------------------------------------------
# Override the VM name UTM looks for when re-launching
#POSTHOGOS_UTM_VM=PosthogOS

# --- GPG signing key (optional locally; required in CI) --------------------
# Local builds run unsigned by default. The build-time [posthogos] repo
# uses SigLevel=Optional so unsigned is fine, and in-container-build.sh
# only hard-fails if it can't find the key when CI=1 / GITHUB_ACTIONS=1.
# Set these only if you want to produce signed .pkg.tar.zst locally (e.g.
# to test signing flow without cutting a release).
#
# Path to the armored secret-key file
# (gpg --armor --export-secret-keys packages@posthog.com > posthogos-packager.sec).
# bin/build reads the file into POSTHOGOS_PACKAGER_KEY before docker run.
# Multi-line PEM blocks can't live directly in .env, hence the indirection.
#POSTHOGOS_PACKAGER_KEY_FILE=/Users/you/secrets/posthogos-packager.sec
# The key's fingerprint (gpg --fingerprint packages@posthog.com)
#POSTHOGOS_PACKAGER_KEY_FPR=4EBCA8A804A59A4F2D5670AE55736D1EBA43BEF3
