# Copy to `.env` (which is .gitignored) and edit for your machine.
# Auto-sourced by bin/build and bin/test before any of their own logic
# runs, so anything you set here behaves like an env var on the command
# line.

# --- AppImage bundling -----------------------------------------------------
# Path to a PostHog Code AppImage
#POSTHOG_CODE_APPIMAGE=/Users/you/Downloads/posthog-code.AppImage

# --- Build modes -----------------------------------------------------------
# Saves ~10-15 min per build 
#FAST_BUILD=1

# KEEP_BUILD=1: don't `rm -rf build/` after a successful build. Faster
# next-iteration since pacstrap reuses the existing dir, but eats ~10 GB.
#KEEP_BUILD=1

# --- Icon theme variant ----------------------------------------------------
# POSTHOGOS_ICON_VARIANT: which set of PostHog product icons to ship
# under /usr/share/icons/PosthogOS/. Picks the source dir under
# branding/posthogos/icons/. Default: modern (the Mac OS 9 chiseled
# look from posthog.com's "Product OS" page).
#POSTHOGOS_ICON_VARIANT=classic

# --- QEMU test tunables (bin/test only) -----------------------------------
# Guest RAM / vCPUs / CPU model for `bin/test`. See `bin/test --help`
# for full docs. Apple Silicon TCG defaults to Penryn for fastest
# translation; bump to `max` for full instruction-set fidelity if a
# test needs it.
#POSTHOGOS_QEMU_RAM=8G
#POSTHOGOS_QEMU_SMP=8
#POSTHOGOS_QEMU_CPU=Penryn

# --- UTM only (bin/test --utm) --------------------------------------------
# Override the VM name UTM looks for when re-launching. Default
# "PosthogOS".
#POSTHOGOS_UTM_VM=PosthogOS-Dev
