[Icon Theme]
Name=PosthogOS
Comment=PostHog product icons (modern variant), inheriting from Papirus-Light
Inherits=Papirus-Light,hicolor
Example=folder
DisplayDepth=32
Directories=32x32/apps,32x32/places,32x32/mimetypes,32x32/actions,32x32/categories,32x32/devices,32x32/status,48x48/apps,48x48/places,48x48/mimetypes,48x48/actions,48x48/categories,48x48/devices,48x48/status,64x64/apps,64x64/places,64x64/mimetypes,64x64/actions,64x64/categories,64x64/devices,64x64/status,128x128/apps,128x128/places,128x128/mimetypes,128x128/actions,128x128/categories,128x128/devices,128x128/status,256x256/apps,256x256/places,256x256/mimetypes,256x256/actions,256x256/categories,256x256/devices,256x256/status

