// PosthogOS boot splash
//
// Solid #151515 background, PostHog logomark centred, gently pulsing
// to indicate liveness. Three loading dots below the logo. Updates
// progress via the standard Plymouth refresh callback.
//
// Plymouth scripting reference:
//   https://www.freedesktop.org/wiki/Software/Plymouth/Scripts/

# ---- Background ----------------------------------------------------------
Window.SetBackgroundTopColor(0.082, 0.082, 0.082);     // #151515
Window.SetBackgroundBottomColor(0.082, 0.082, 0.082);  // #151515

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# ---- Logo (centred) ------------------------------------------------------
logo.image = Image("logo.png");
logo.w = logo.image.GetWidth();
logo.h = logo.image.GetHeight();
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(screen_w / 2 - logo.w / 2);
logo.sprite.SetY(screen_h / 2 - logo.h / 2);

# ---- Loading dots --------------------------------------------------------
dot.image = Image("dot.png");
dot.w = dot.image.GetWidth();
dot.h = dot.image.GetHeight();
dot.spacing = 16;
dot.row_y = screen_h / 2 + logo.h / 2 + 40;
dot.row_x = screen_w / 2 - (dot.w * 3 + dot.spacing * 2) / 2;

for (i = 0; i < 3; i++) {
    dots[i].sprite = Sprite(dot.image);
    dots[i].sprite.SetX(dot.row_x + i * (dot.w + dot.spacing));
    dots[i].sprite.SetY(dot.row_y);
    dots[i].sprite.SetOpacity(0.25);
}

# ---- Animation -----------------------------------------------------------
progress = 0;

fun refresh_callback() {
    progress += 0.04;

    // Pulse the logo opacity 0.65 → 1.0
    pulse = (Math.Sin(progress) + 1) / 2;       // 0..1
    logo.sprite.SetOpacity(0.65 + pulse * 0.35);

    // Walk the dots: each dot lights up in turn
    active = Math.Int(progress * 1.5) % 3;
    for (i = 0; i < 3; i++) {
        if (i == active)
            dots[i].sprite.SetOpacity(1.0);
        else
            dots[i].sprite.SetOpacity(0.25);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# Hide everything once boot finishes
fun quit_callback() {
    logo.sprite.SetOpacity(0);
    for (i = 0; i < 3; i++) dots[i].sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);

# Password prompts (used at boot if disk is encrypted)
status = "normal";
fun display_password_callback(prompt, bullets) {
    status = "password";
}
fun display_normal_callback() {
    status = "normal";
}
fun message_callback(text) {}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetMessageFunction(message_callback);
