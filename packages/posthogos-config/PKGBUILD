# Maintainer: PostHog <hey@posthog.com>
# shellcheck disable=SC2034,SC2154
#
# posthogos-config: /etc/skel dotfiles (zsh, git, ghostty, zellij).
# Source: overlay/airootfs/etc/skel/. KDE/GTK skel files
# (kdeglobals, gtk-{3,4}.0, konsolerc) are written by customize.sh
# instead, because cachyos-kde-settings already owns those paths.

pkgname=posthogos-config
pkgver=0.1.1
pkgrel=1
pkgdesc='PosthogOS /etc/skel dotfiles (zsh, git, ghostty, zellij)'
arch=('any')
url='https://github.com/posthog/linux-posthogos'
license=('MIT')

# The tools the dotfiles configure. Soft so the package stays cheap.
optdepends=(
    'zsh: reads /etc/skel/.zshrc'
    'git: reads /etc/skel/.gitconfig'
    'ghostty: reads /etc/skel/.config/ghostty/'
    'zellij: reads /etc/skel/.config/zellij/'
)

# pkgver: latest git tag (v-stripped), or 0.0.0.dev.<sha> when no tags.
pkgver() {
    if [ -n "${POSTHOGOS_PKGVER:-}" ]; then
        echo "${POSTHOGOS_PKGVER#v}"
        return
    fi
    cd "$startdir/../.."
    local v
    v=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -z "$v" ]; then
        v="0.0.0.dev.$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "$v"
}

package() {
    local repo_root overlay
    repo_root="$startdir/../.."
    overlay="$repo_root/overlay/airootfs"

    install -Dm 0644 "$overlay/etc/skel/.zshrc"     "$pkgdir/etc/skel/.zshrc"
    install -Dm 0644 "$overlay/etc/skel/.gitconfig" "$pkgdir/etc/skel/.gitconfig"
    install -Dm 0644 "$overlay/etc/skel/.config/ghostty/config" \
        "$pkgdir/etc/skel/.config/ghostty/config"
    install -Dm 0644 "$overlay/etc/skel/.config/zellij/config.kdl" \
        "$pkgdir/etc/skel/.config/zellij/config.kdl"
    install -Dm 0644 "$overlay/etc/skel/.config/zellij/layouts/posthogos-dev.kdl" \
        "$pkgdir/etc/skel/.config/zellij/layouts/posthogos-dev.kdl"

    install -Dm 0644 "$repo_root/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
