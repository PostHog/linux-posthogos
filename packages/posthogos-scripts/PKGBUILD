# Maintainer: PostHog <hey@posthog.com>
# shellcheck disable=SC2034,SC2154
#
# posthogos-scripts: firstrun / snapper-init / toolkit-installer / neohog.
# Source: overlay/airootfs/. systemd enablement via pre-baked symlinks in
# /usr/lib/systemd/system/multi-user.target.wants/ (no .install hook).

pkgname=posthogos-scripts
pkgver=0.0.0.dev.e70abd1
pkgrel=1
pkgdesc='PosthogOS system scripts: firstrun, snapper-init, toolkit-install, neohog'
arch=('any')
url='https://github.com/posthog/linux-posthogos'
license=('MIT')

# Probed at runtime; scripts degrade gracefully if absent.
optdepends=(
    'snapper: posthogos-snapper-init configures snapper if installed'
    'snap-pac: pre/post snapshots on pacman ops (paired with snapper)'
    'grub-btrfs: snapper-init enables grub-btrfsd for GRUB snapshot menu'
    'fastfetch: neohog falls through to it (or neofetch) for the actual render'
    'btrfs-progs: snapper-init checks rootfs fstype, only configures on btrfs'
)

# pkgver: latest git tag (v-stripped), or 0.0.0.dev.<sha> when no tags.
pkgver() {
    if [ -n "${POSTHOGOS_PKGVER:-}" ]; then
        echo "${POSTHOGOS_PKGVER#v}"
        return
    fi
    cd "$startdir/../.."
    local v
    v=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -z "$v" ]; then
        v="0.0.0.dev.$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "$v"
}

package() {
    local repo_root overlay
    repo_root="$startdir/../.."
    overlay="$repo_root/overlay/airootfs"

    # /usr/local/bin: technically admin namespace but the .desktop files
    # and wrappers reference these absolute paths. Pacman accepts it.
    install -d "$pkgdir/usr/local/bin"
    install -m 0755 \
        "$overlay/usr/local/bin/neohog" \
        "$overlay/usr/local/bin/papirus-folders" \
        "$overlay/usr/local/bin/posthogos-firstrun.sh" \
        "$overlay/usr/local/bin/posthogos-firstrun-rescue.sh" \
        "$overlay/usr/local/bin/posthogos-snapper-init" \
        "$overlay/usr/local/bin/posthogos-toolkit-install" \
        "$pkgdir/usr/local/bin/"

    # XDG autostart (live-session first-login trigger).
    install -Dm 0644 "$overlay/etc/xdg/autostart/posthogos-firstrun.desktop" \
        "$pkgdir/etc/xdg/autostart/posthogos-firstrun.desktop"

    # systemd units, vendor location.
    install -Dm 0644 "$overlay/etc/systemd/system/posthogos-snapper-init.service" \
        "$pkgdir/usr/lib/systemd/system/posthogos-snapper-init.service"
    install -Dm 0644 "$overlay/etc/systemd/system/posthogos-firstrun-rescue.service" \
        "$pkgdir/usr/lib/systemd/system/posthogos-firstrun-rescue.service"

    # Vendor enablement: symlinks in /usr/lib/.../<target>.wants/ are
    # treated as enabled by systemd. No install hook needed.
    install -d "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
    ln -sf "../posthogos-snapper-init.service" \
        "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/posthogos-snapper-init.service"
    ln -sf "../posthogos-firstrun-rescue.service" \
        "$pkgdir/usr/lib/systemd/system/multi-user.target.wants/posthogos-firstrun-rescue.service"

    # ── License ───────────────────────────────────────────────────────────
    install -Dm 0644 "$repo_root/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
