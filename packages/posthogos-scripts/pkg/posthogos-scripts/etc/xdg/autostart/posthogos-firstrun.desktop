[Desktop Entry]
Type=Application
Name=PosthogOS first-run setup
Comment=Apply the PosthogOS Plasma theme on first login
Exec=/usr/local/bin/posthogos-firstrun.sh
NoDisplay=true
Terminal=false
# No OnlyShowIn: Plasma 6's desktop env name may not match the old
# "KDE" string; better to run everywhere and let the script bail out
# gracefully on non-Plasma sessions via its marker check.
X-GNOME-Autostart-enabled=true
X-KDE-autostart-after=plasma-session-running
