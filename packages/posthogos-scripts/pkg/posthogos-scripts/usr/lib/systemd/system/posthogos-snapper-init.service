[Unit]
Description=PosthogOS first-boot snapper initialization
# Wait for / to actually be mounted before we ask findmnt about its fstype.
After=local-fs.target
# Don't run on the live ISO (we also gate inside the script).
ConditionPathExists=!/run/archiso/livedevice
# Idempotent at the systemd layer too: if config already exists, skip.
ConditionPathExists=!/etc/snapper/configs/root

[Service]
Type=oneshot
ExecStart=/usr/local/bin/posthogos-snapper-init
# Don't restart. The script is idempotent but a retry loop accomplishes nothing
# if the underlying environment (fstype, package availability) hasn't changed.
Restart=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
