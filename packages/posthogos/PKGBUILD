# Maintainer: PostHog <hey@posthog.com>
# shellcheck disable=SC2034,SC2154
#
# posthogos: meta-package. `pacman -S posthogos` pulls the full stack;
# `-Rs` cascades the removal.

pkgname=posthogos
pkgver=0.1.1
pkgrel=1
pkgdesc='PosthogOS: meta-package pulling the full PosthogOS stack'
arch=('any')
url='https://github.com/posthog/linux-posthogos'
license=('MIT')

depends=(
    'posthogos-keyring'    # must come first; trust bootstrap for SigLevel=Required
    'posthogos-branding'
    'posthogos-scripts'
    'posthogos-welcome'
    'posthogos-config'

    # Curated system stack that makes up the full PosthogOS experience.
    # The sub-packages keep these soft (optdepends) so they stay lean on
    # their own; the meta is what guarantees the opinionated whole. This
    # is also what installs them on a Calamares target (the live ISO gets
    # them via scripts/pre-build.sh's pacstrap list). Keep in sync with
    # the system-package block in scripts/pre-build.sh.
    'inter-font'           # primary system body font (referenced in kdeglobals)
    'papirus-icon-theme'   # parent theme the PosthogOS icon theme inherits
    'ghostty'              # default terminal (skel configs + Plasma pins)
    'flatpak'              # secondary app channel (Flathub set up in apply-common)
    'snapper'              # btrfs snapshots; initialized by posthogos-snapper-init
    'snap-pac'             # pacman hooks: snapshot before/after every -S/U/R
    'grub-btrfs'           # GRUB submenu entries for each snapper snapshot
    'fuse2'                # libfuse2 for AppImages (e.g. posthog-code)
    'nodejs'               # dev-toolkit's `npm install -g` for AI CLIs
    'npm'
)

# pkgver: latest git tag (v-stripped), or 0.0.0.dev.<sha> when no tags.
pkgver() {
    if [ -n "${POSTHOGOS_PKGVER:-}" ]; then
        echo "${POSTHOGOS_PKGVER#v}"
        return
    fi
    cd "$startdir/../.."
    local v
    v=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -z "$v" ]; then
        v="0.0.0.dev.$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "$v"
}

package() {
    install -Dm 0644 "$startdir/../../LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
