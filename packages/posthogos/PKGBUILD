# Maintainer: PostHog <hey@posthog.com>
# shellcheck disable=SC2034,SC2154
#
# posthogos: meta-package. `pacman -S posthogos` pulls the full stack;
# `-Rs` cascades the removal.

pkgname=posthogos
pkgver=0.0.0
pkgrel=1
pkgdesc='PosthogOS: meta-package pulling the full PosthogOS stack'
arch=('any')
url='https://github.com/posthog/linux-posthogos'
license=('MIT')

depends=(
    'posthogos-keyring'    # must come first; trust bootstrap for SigLevel=Required
    'posthogos-branding'
    'posthogos-scripts'
    'posthogos-welcome'
    'posthogos-config'
)

# pkgver: latest git tag (v-stripped), or 0.0.0.dev.<sha> when no tags.
pkgver() {
    if [ -n "${POSTHOGOS_PKGVER:-}" ]; then
        echo "${POSTHOGOS_PKGVER#v}"
        return
    fi
    cd "$startdir/../.."
    local v
    v=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -z "$v" ]; then
        v="0.0.0.dev.$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "$v"
}

package() {
    install -Dm 0644 "$startdir/../../LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
