# Maintainer: PostHog <hey@posthog.com>
# shellcheck disable=SC2034,SC2154
#
# posthogos: meta-package pulling the full PosthogOS stack.
#
# Lets a fresh Arch / CachyOS install opt into PosthogOS with a single `pacman -S posthogos`, and
# lets removal of the brand cleanly cascade if a user wants to revert.
#
# No files of its own — pure depends list. Pacman handles the dep graph.

pkgname=posthogos
pkgver=0.0.0
pkgrel=1
pkgdesc='PosthogOS: meta-package pulling the full PosthogOS stack'
arch=('any')
url='https://github.com/posthog/linux-posthogos'
license=('MIT')

depends=(
    'posthogos-keyring'    # pubring; must already be trusted for the
                           # others to verify under SigLevel=Required
    'posthogos-branding'   # icons, wallpapers, LAF, fonts, sounds, themes
    'posthogos-scripts'    # firstrun, snapper-init, toolkit-install, neohog
    'posthogos-welcome'    # welcome window + launcher
    'posthogos-config'     # /etc/skel dotfiles (zsh, git, ghostty, zellij)
)

pkgver() {
    cd "$startdir/../.."
    git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//' || echo "0.0.0"
}

package() {
    # Meta-package: no files, just the depends list above. The license
    # link is the one real artifact — every package gets one.
    install -Dm 0644 "$startdir/../../LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
