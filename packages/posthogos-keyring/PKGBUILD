# Maintainer: PostHog <hey@posthog.com>
# shellcheck disable=SC2034,SC2154
#
# posthogos-keyring: PostHog packager pubring + a pacman .install hook
# that locally signs the key. Required for SigLevel=Required on [posthogos].
#
# Key rotation: a new keyring must be signed with the OLD key so
# trusting-old systems can still install + adopt the new trust.

pkgname=posthogos-keyring
pkgver=0.0.0.dev.e70abd1
pkgrel=1
pkgdesc='PosthogOS pacman keyring (PostHog packager public key)'
arch=('any')
url='https://github.com/posthog/linux-posthogos'
license=('MIT')
install="${pkgname}.install"
source=(
    'posthogos.gpg'
    'posthogos-trusted'
    'posthogos-revoked'
)
sha256sums=('SKIP' 'SKIP' 'SKIP')   # local files

# pkgver: latest git tag (v-stripped), or 0.0.0.dev.<sha> when no tags.
pkgver() {
    # CI (and in-container builds generally) inject the resolved version
    # via this env var so we don't rely on git working inside makepkg's
    # subshell (which has flaked under sudo + bind-mounted repos).
    if [ -n "${POSTHOGOS_PKGVER:-}" ]; then
        echo "${POSTHOGOS_PKGVER#v}"
        return
    fi
    cd "$startdir/../.."
    local v
    v=$(git describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')
    if [ -z "$v" ]; then
        v="0.0.0.dev.$(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    fi
    echo "$v"
}

package() {
    install -Dm 0644 "$srcdir/posthogos.gpg"     "$pkgdir/usr/share/pacman/keyrings/posthogos.gpg"
    install -Dm 0644 "$srcdir/posthogos-trusted" "$pkgdir/usr/share/pacman/keyrings/posthogos-trusted"
    install -Dm 0644 "$srcdir/posthogos-revoked" "$pkgdir/usr/share/pacman/keyrings/posthogos-revoked"
}
