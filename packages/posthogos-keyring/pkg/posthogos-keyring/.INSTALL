# Hooks fired by pacman post-install / post-upgrade / pre-remove of
# posthogos-keyring. Uses absolute /usr/bin paths because $PATH isn't
# guaranteed in scriptlet contexts (e.g. pacstrap'd chroots).

post_install() {
    # If pacman-key has been initialized in this rootfs, import + sign.
    # Otherwise this is a fresh pacstrap and `pacman-key --init` will run
    # later (or already ran from archlinux-keyring's own hook); the
    # populate then happens on first `pacman -Syu`. Either way we don't
    # want to fail the install.
    if /usr/bin/pacman-key -l >/dev/null 2>&1; then
        /usr/bin/pacman-key --populate posthogos
        /usr/bin/pacman-key --updatedb
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    if /usr/bin/pacman-key -l >/dev/null 2>&1; then
        /usr/bin/pacman-key --delete 4EBCA8A804A59A4F2D5670AE55736D1EBA43BEF3 2>/dev/null || true
        /usr/bin/pacman-key --updatedb
    fi
}
