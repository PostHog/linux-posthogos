# Absolute /usr/bin paths: $PATH isn't guaranteed in scriptlet context.

post_install() {
    # Skip if pacman-key isn't initialized yet (fresh pacstrap); populate
    # will run on first `pacman -Syu` instead.
    if /usr/bin/pacman-key -l >/dev/null 2>&1; then
        /usr/bin/pacman-key --populate posthogos
        /usr/bin/pacman-key --updatedb
    fi
}

post_upgrade() {
    post_install
}

pre_remove() {
    if /usr/bin/pacman-key -l >/dev/null 2>&1; then
        /usr/bin/pacman-key --delete 4EBCA8A804A59A4F2D5670AE55736D1EBA43BEF3 2>/dev/null || true
        /usr/bin/pacman-key --updatedb
    fi
}
